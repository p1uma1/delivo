# ─── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── JWT Secrets ───────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Third Party OAuth (Google) ──────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── RabbitMQ ──────────────────────────────────────────────────────────────────
# Docker: use service name "rabbitmq". Local (no Docker): use "localhost"
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=delivo.events

# ─── Database ──────────────────────────────────────────────────────────────────
# Supabase example: postgresql://postgres:password@db.<project>.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ─── Service Ports ─────────────────────────────────────────────────────────────
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3002
DELIVERY_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
NOTIFICATION_SOCKET_PORT=3006

# ─── Service Internal URLs (used by API Gateway) ───────────────────────────────
# Docker: use Docker service names. Local (no Docker): change to localhost
USER_SERVICE_URL=http://user-service:3001
ORDER_SERVICE_URL=http://order-service:3002
DELIVERY_SERVICE_URL=http://delivery-service:3003
PRODUCT_SERVICE_URL=http://product-service:3004
CART_SERVICE_URL=http://cart-service:3005
NOTIFICATION_SOCKET_URL=http://notification-service:3006


# ─── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Browser-side WebSocket — always use localhost (Docker maps port 3006 to host)
VITE_NOTIFICATION_SOCKET_URL=http://localhost:3006
# VITE_API_URL is automatically set to http://api-gateway:3000 by docker-compose
# for local dev outside Docker it falls back to http://localhost:3000

# ─── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── JWT Secrets ───────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=delivo.events

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=delivo
POSTGRES_PASSWORD=delivopassword
POSTGRES_HOST=postgres

# Per-service database URLs (used by Prisma)
USER_SERVICE_DATABASE_URL=postgresql://delivo:delivopassword@postgres:5432/user_db?schema=public
ORDER_SERVICE_DATABASE_URL=postgresql://delivo:delivopassword@postgres:5432/order_db?schema=public
DELIVERY_SERVICE_DATABASE_URL=postgresql://delivo:delivopassword@postgres:5432/delivery_db?schema=public
NOTIFICATION_SERVICE_DATABASE_URL=postgresql://delivo:delivopassword@postgres:5432/notification_db?schema=public

# ─── Service Ports ─────────────────────────────────────────────────────────────
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3002
DELIVERY_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004

# ─── Service Internal URLs (used by API Gateway) ───────────────────────────────
USER_SERVICE_URL=http://user-service:3001
ORDER_SERVICE_URL=http://order-service:3002
DELIVERY_SERVICE_URL=http://delivery-service:3003

# ─── Email / SMS Stubs (swap with real provider keys) ──────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
SMS_PROVIDER_API_KEY=your_sms_api_key

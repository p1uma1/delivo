# ─── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Messaging (RabbitMQ) ─────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=delivo.events

# ─── Infrastructure (PostgreSQL) ──────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ─── Service Ports ─────────────────────────────────────────────────────────────
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3002
DELIVERY_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004

# ─── Service Internal URLs (used by API Gateway) ───────────────────────────────
USER_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_URL=http://localhost:3002
DELIVERY_SERVICE_URL=http://localhost:3003

# ─── Email / SMS Stubs (swap with real provider keys) ──────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
SMS_PROVIDER_API_KEY=your_sms_api_key

# ─── Global ───────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── API Gateway ──────────────────────────────────────────────────────────
API_GATEWAY_PORT=3000

# ─── Auth ─────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_access_secret_change_me_123
JWT_REFRESH_SECRET=your_refresh_secret_change_me_456

# ─── Messaging (RabbitMQ) ─────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=delivo.events

# ─── Infrastructure ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

